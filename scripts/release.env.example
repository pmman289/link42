# Copy to scripts/release.env and edit for your environment.
#
# The publish scripts load scripts/release.env automatically when it exists.
# Environment variables passed on the command line still take precedence over
# values in this file:
#   IMAGE_REPO=your-dockerhub-user/link42 scripts/release-all.sh
# Installation scripts and Agent/UDP2RAW assets are served by the controller.

# Docker image repository.
IMAGE_REPO=your-dockerhub-user/link42
