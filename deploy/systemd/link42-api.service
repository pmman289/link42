[Unit]
Description=Link42 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/link42
Environment=LINK42_DATABASE_URL=sqlite:////opt/link42/link42.db
Environment=FORWARDED_ALLOW_IPS=127.0.0.1
ExecStart=/opt/link42/.venv/bin/uvicorn link42_api.main:app --host 0.0.0.0 --port 8000 --proxy-headers --timeout-keep-alive 65 --no-access-log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
